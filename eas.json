{
  "cli": {
    "version": ">= 15.0.0"
  },
  "build": {
    "sideload-unsigned": {
      "developmentClient": false,
      "distribution": "internal",
      "ios": {
        "simulator": false,
        "buildConfiguration": "Release",
        "enterpriseProvisioning": "adhoc"
      },
      "env": {
        "CODE_SIGNING_ALLOWED": "NO",
        "CODE_SIGNING_REQUIRED": "NO",
        "CODE_SIGN_IDENTITY": "-"
      },
      "channel": "production",
      "autoIncrement": false
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "developmentClient": false,
      "distribution": "store"
    }
  },
  "submit": {
    "production": {}
  }
}
